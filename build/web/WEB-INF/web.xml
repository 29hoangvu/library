<?xml version="1.0" encoding="UTF-8"?>
<web-app version="5.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd">
    <display-name>NLN_Library</display-name>
    <context-param>
        <param-name>ebook.baseDir</param-name>
        <param-value>D:/Nam4/LuanVan/NLN_Library/uploads/</param-value>
    </context-param>
    <!-- Lỗi 404 -->
    <error-page>
        <error-code>404</error-code>
        <location>/404.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>
    <!-- Filter mã hóa -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>forceEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <!-- Thời gian session -->
    <servlet>
        <servlet-name>ReminderJobServlet</servlet-name>
        <servlet-class>Servlet.ReminderJobServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EbookStreamServlet</servlet-name>
        <servlet-class>Servlet.EbookStreamServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookFilterServlet</servlet-name>
        <servlet-class>Servlet.BookFilterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TrackReadServlet</servlet-name>
        <servlet-class>Servlet.TrackReadServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExportReportExcelServlet</servlet-name>
        <servlet-class>Servlet.ExportReportExcelServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RestoreBookServlet</servlet-name>
        <url-pattern>/RestoreBookServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReminderJobServlet</servlet-name>
        <url-pattern>/cron/reminders</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EbookStreamServlet</servlet-name>
        <url-pattern>/ebook</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookFilterServlet</servlet-name>
        <url-pattern>/filterBooks</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TrackReadServlet</servlet-name>
        <url-pattern>/trackRead</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExportReportExcelServlet</servlet-name>
        <url-pattern>/ExportReportExcelServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <!-- ==== KHAI BÁO SERVLET ==== -->
    <servlet>
        <servlet-name>CheckAvailabilityServlet</servlet-name>
        <servlet-class>Servlet.CheckAvailabilityServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PaymentReturnServlet</servlet-name>
        <servlet-class>Payment.PaymentReturnServlet</servlet-class>
    </servlet>
    <!-- VNPAY samples -->
    <servlet>
        <servlet-name>ajaxServlet</servlet-name>
        <servlet-class>com.vnpay.common.ajaxServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>vnpayQuery</servlet-name>
        <servlet-class>com.vnpay.common.vnpayQuery</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>vnpayRefund</servlet-name>
        <servlet-class>com.vnpay.common.vnpayRefund</servlet-class>
    </servlet>
    <!-- App servlets -->
    <servlet>
        <servlet-name>PasswordHashing</servlet-name>
        <servlet-class>Servlet.PasswordHashing</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RenewServlet</servlet-name>
        <servlet-class>Servlet.RenewServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteBookServlet</servlet-name>
        <servlet-class>Servlet.DeleteBookServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RestoreBookServlet</servlet-name>
        <servlet-class>Servlet.RestoreBookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckAvailabilityServlet</servlet-name>
        <url-pattern>/CheckAvailabilityServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentReturnServlet</servlet-name>
        <url-pattern>/PaymentReturnServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ajaxServlet</servlet-name>
        <url-pattern>/vnpayajax/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>vnpayQuery</servlet-name>
        <url-pattern>/vnpayquery/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>vnpayRefund</servlet-name>
        <url-pattern>/vnpayrefund/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PasswordHashing</servlet-name>
        <url-pattern>/PasswordHashing</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RenewServlet</servlet-name>
        <url-pattern>/RenewServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteBookServlet</servlet-name>
        <url-pattern>/DeleteBookServlet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ReservationAPI</servlet-name>
        <servlet-class>api.ReservationAPI</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>ReservationAPI</servlet-name>
        <url-pattern>/api/reservation/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AdminUploadExcelServlet</servlet-name>
        <servlet-class>Servlet.AdminUploadExcelServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AdminUploadExcelServlet</servlet-name>
        <url-pattern>/AdminUploadExcelServlet</url-pattern>
    </servlet-mapping>
</web-app>
